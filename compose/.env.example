# Copy to .env. UID/GID should match the host user that owns ./data
# (and, in production, the Syncthing user) so files stay editable on the host.
UID=1000
GID=1000

# Author of commits made by llm-wiki.
GIT_AUTHOR_NAME=llm-wiki
GIT_AUTHOR_EMAIL=llm-wiki@localhost

# Wiki created on first start (registered as default).
LLM_WIKI_BOOTSTRAP_WIKI=main

# Search score multiplier for retired pages (status: archived / superseded).
# 0.0 sorts them below every live hit; they still appear in wiki_search
# results (see docs/decisions.md V7).
LLM_WIKI_SEARCH_ARCHIVED=0.0
LLM_WIKI_SEARCH_SUPERSEDED=0.0

# Image tags (pinned). Bump together with the Dockerfile ARGs.
LLM_WIKI_VERSION=1.0.1
LLM_WIKI_IMAGE=knowledge/llm-wiki:1.0.1
WIKI_INBOX_IMAGE=knowledge/wiki-inbox:0.1.0
# Or use the images CI publishes from main instead of building locally
# (`docker compose pull`, then `up` without --build). Pin by sha-<commit>
# or digest in production; the version tags move with each push to main.
# LLM_WIKI_IMAGE=ghcr.io/jeroenluchtenberg/knowledge/llm-wiki:1.0.1
# WIKI_INBOX_IMAGE=ghcr.io/jeroenluchtenberg/knowledge/wiki-inbox:0.1.0
AGENTGATEWAY_IMAGE=ghcr.io/agentgateway/agentgateway:v1.6.0@sha256:9d3e6044ddcdc0878b1787f77bd401252b95e22684203fb5e874c4c42d2ed90c

# Host ports (bound to 127.0.0.1).
LLM_WIKI_PORT=8080
WIKI_INBOX_PORT=8081
AGENTGATEWAY_PORT=3000

# wiki-inbox
INBOX_FETCH_ALLOW_PRIVATE=false
INBOX_READ_ONLY=false
